# Copy to .env (never commit it) and export before starting. See docs/DEPLOYMENT.md.
# ---- Mode -----------------------------------------------------------------------------------------
# development (default) = demo identities, no sign-in. production = real accounts, secure cookies.
BRANDGUARD_ENV=production
# accounts (default in production) or demo. Demo in production additionally needs BRANDGUARD_PASSCODE.
BRANDGUARD_AUTH=accounts
BRANDGUARD_SECRET=change-me-to-a-long-random-string        # signs session cookies (required in production)
BRANDGUARD_ADMIN_EMAIL=you@example.com                     # first start only: creates the first admin
BRANDGUARD_ADMIN_PASSWORD=use-a-long-unique-password       # 10+ characters; remove after first start
# BRANDGUARD_PASSCODE=                                     # demo mode only
# BRANDGUARD_ADMIN_PASSCODE=                               # demo mode only
# ---- Data -------------------------------------------------------------------------------------------
BRANDGUARD_DB=/data/brandguard.db
# BRANDGUARD_ALLOWED_ORIGINS=https://brandguard.example.com   # extra origins allowed to write (e.g. behind a proxy)
# ---- AI judge (optional) ----------------------------------------------------------------------------
# ANTHROPIC_API_KEY=
# BRANDGUARD_MODEL=claude-sonnet-5-5
# BRANDGUARD_LLM=off                                       # force rules-only
# BRANDGUARD_AI_TIMEOUT=20                                 # seconds a review may wait for the AI
BRANDGUARD_AI_LOG=metadata                                 # metadata (default) or full
BRANDGUARD_AI_RETENTION_DAYS=30                            # 0 keeps nothing
# ---- Operations -------------------------------------------------------------------------------------
BRANDGUARD_LOG_JSON=1                                      # one JSON line per request, never any content
