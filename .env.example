# Copy to .env (never commit it) and export before starting. See docs/DEPLOYMENT.md.
# ---- Mode -----------------------------------------------------------------------------------------
# development (default) = local demo identities. production = real accounts, secure cookies.
BRANDGUARD_ENV=production
# accounts (default in production) or demo.
BRANDGUARD_AUTH=accounts
BRANDGUARD_SECRET=change-me-to-a-long-random-string        # signs session cookies (required in production)
BRANDGUARD_ADMIN_EMAIL=you@example.com                     # first start only: creates the first admin
BRANDGUARD_ADMIN_PASSWORD=use-a-long-unique-password       # 10+ characters; remove after first start
# BRANDGUARD_DATA_KEY=another-long-random-string          # encrypts authenticator secrets (default: derived from BRANDGUARD_SECRET)
# BRANDGUARD_PASSCODE=                                     # demo mode only
# BRANDGUARD_ADMIN_PASSCODE=                               # demo mode only
# ---- Data -------------------------------------------------------------------------------------------
BRANDGUARD_DB=/data/brandguard.db
BRANDGUARD_TRUSTED_PROXIES=1                               # number of reverse proxies in front (0 if none)
# BRANDGUARD_ALLOWED_ORIGINS=https://brandguard.example.com   # extra origins allowed to write (e.g. behind a proxy)
# ---- AI judge (optional) ----------------------------------------------------------------------------
# ANTHROPIC_API_KEY=
# Or any OpenAI-compatible provider (takes precedence when the base URL is set):
# BRANDGUARD_LLM_BASE_URL=https://bharatcode.ai/api/model/v1
# BRANDGUARD_LLM_API_KEY=
# BRANDGUARD_MODEL=qwen-3.8-27b   # required for this provider
# BRANDGUARD_LLM_REASONING=medium   # none|low|medium|high; output limits include reasoning
# BRANDGUARD_LLM_MAX_TOKENS=8000     # up to 32000; raise it when reasoning is on
# (Anthropic only) BRANDGUARD_MODEL defaults to claude-sonnet-5-5
# BRANDGUARD_LLM=off                                       # force rules-only
# BRANDGUARD_AI_TIMEOUT=20                                 # seconds a review may wait for the AI
BRANDGUARD_AI_LOG=metadata                                 # metadata (default) or full
BRANDGUARD_AI_RETENTION_DAYS=30                            # 0 keeps nothing
# ---- Operations -------------------------------------------------------------------------------------
BRANDGUARD_LOG_JSON=1                                      # one JSON line per request, never any content
# ---- Demo sites only: seed a complete Brewline workspace ---------------------------------------------
# When both are set, the landing page exposes "Try demo" and pre-fills the demo credentials on /login.
# After one sign-in, the demo user can switch roles without another email/password login.
# BRANDGUARD_SEED_DEMO=1
# BRANDGUARD_DEMO_PASSWORD=          # 10+ chars; creates neha/arjun/meera/rahul@brewline.demo and one sample draft
